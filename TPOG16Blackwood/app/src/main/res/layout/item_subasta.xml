<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_subasta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:background="@drawable/card_white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Fila superior: Estado / CATEGORIA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Dot verde/rojo + Estado -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/dot_estado"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/circle_gold"
                android:backgroundTint="#5C7A65" />
            <TextView
                android:id="@+id/tv_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En sala"
                android:textColor="#6B6B6B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Etiqueta CATEGORIA -->
        <TextView
            android:id="@+id/tv_categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORO"
            android:textColor="#C6A75E"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fecha y hora -->
    <TextView
        android:id="@+id/tv_fecha_hora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="12 Marzo · 18:00"
        android:textColor="#1A1A1A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0DEDA"
        android:layout_marginBottom="8dp" />

    <!-- Ubicación, Rematador y Lotes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_ubicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buenos Aires · Sala Central"
                android:textColor="#6B6B6B"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tv_rematador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rematador: Gómez"
                android:textColor="#6B6B6B"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_moneda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="Moneda: ARS"
            android:textColor="#6B6B6B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Descripción / Estimación inicial -->
    <TextView
        android:id="@+id/tv_descripcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Subasta de arte contemporáneo"
        android:textColor="#C6A75E"
        android:textSize="13sp" />
</LinearLayout>
