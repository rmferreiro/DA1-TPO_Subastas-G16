<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/info_box"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Nombre del producto -->
    <TextView
        android:id="@+id/tv_producto_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="Producto"
        android:textColor="#1A1A1A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Descripción de la subasta -->
    <TextView
        android:id="@+id/tv_subasta_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Subasta"
        android:textColor="#6B6B6B"
        android:textSize="12sp" />

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="10dp"
        android:background="#E5E0D8" />

    <!-- Contenedor dinámico para cada oferta: "Ofertaste $X" -->
    <LinearLayout
        android:id="@+id/ll_bids_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp" />

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="10dp"
        android:background="#E5E0D8" />

    <!-- Resultado del lote: Ganaste / No ganaste -->
    <TextView
        android:id="@+id/tv_resultado_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Resultado"
        android:textColor="#1C2A21"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Botón pagar (solo lotes ganados) -->
    <TextView
        android:id="@+id/btn_pagar_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_gold"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="Pagar ahora"
        android:textColor="#1C2A21"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
