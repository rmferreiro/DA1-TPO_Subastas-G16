<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#1C2A21">

            <TextView
                android:text="Blackwood Fine Sales"
                android:textColor="#F4F1EA"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Panel del vendedor"
                android:textColor="#C6A75E"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TÍTULO -->
            <TextView
                android:text="Gestión de lotes"
                android:textSize="22sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- BOTÓN CREAR SOLICITUD -->
            <Button
                android:id="@+id/btnCrearSolicitud"
                android:text="+ Crear solicitud"
                android:background="@drawable/button_primary"
                android:textColor="#F4F1EA"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null" />

            <!-- BOTÓN MIS LOTES -->
            <Button
                android:id="@+id/btnMisLotes"
                android:text="Mis lotes"
                android:background="@drawable/button_black_gold"
                android:textColor="#1A1A1A"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null" />

            <!-- BOTÓN MÉTRICAS -->
            <Button
                android:id="@+id/btnMetricas"
                android:text="Métricas"
                android:background="@drawable/button_black_gold"
                android:textColor="#1A1A1A"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null" />

            <!-- INFO BOX -->
            <TextView
                android:text="Gestioná tus artículos para incluir en futuras subastas. Podés dar seguimiento al estado de cada solicitud y consultar tus métricas de venta."
                android:background="@drawable/info_box"
                android:padding="14dp"
                android:textColor="#6B6B6B"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>