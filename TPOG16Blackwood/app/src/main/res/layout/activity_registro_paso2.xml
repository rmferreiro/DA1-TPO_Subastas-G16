<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/marfil">

    <!-- CONTENIDO PRINCIPAL (Registro) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER REUTILIZABLE -->
        <include
            android:id="@+id/include_header"
            layout="@layout/view_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:id="@+id/main_registration_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <!-- CONTENIDO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- SEGURIDAD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/seguridad_title"
                    android:textColor="@color/charcoal"
                    android:textSize="@dimen/text_size_title" />

                <!-- PASSWORD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical">
                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="@drawable/input_bg"
                        android:hint="@string/pass"
                        android:inputType="textPassword"
                        android:importantForAutofill="yes"
                        android:autofillHints="password"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/charcoal"
                        android:textColorHint="@color/gray_medium"
                        android:textSize="@dimen/text_size_body" />
                    <TextView
                        android:id="@+id/error_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/gold"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- CONFIRM PASSWORD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="26dp"
                    android:orientation="vertical">
                    <EditText
                        android:id="@+id/et_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="@drawable/input_bg"
                        android:hint="@string/conf_pass"
                        android:inputType="textPassword"
                        android:importantForAutofill="yes"
                        android:autofillHints="password"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/charcoal"
                        android:textColorHint="@color/gray_medium"
                        android:textSize="@dimen/text_size_body" />
                    <TextView
                        android:id="@+id/error_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/gold"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- MEDIOS DE PAGO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/medios_pago"
                    android:textColor="@color/charcoal"
                    android:textSize="@dimen/text_size_title" />

                <!-- LISTA DE METODOS -->
                <LinearLayout
                    android:id="@+id/container_metodos_pago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- BOTON AGREGAR -->
                 <Button
                    android:id="@+id/btn_agregar_metodo"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/button_black_gold"
                    app:backgroundTint="@null"
                    android:elevation="0dp"
                    android:text="@string/medios_pago_add"
                    android:textAllCaps="false"
                    android:textColor="@color/gray_light"
                    android:textSize="@dimen/text_size_body" />

                <!-- INFO BOX -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/info_box"
                    android:lineSpacingExtra="3dp"
                    android:padding="16dp"
                    android:text="@string/medios_pago_info"
                    android:textColor="@color/gray_light"
                    android:textSize="@dimen/text_size_small" />

                <!-- BOTON FINAL -->
                <Button
                    android:id="@+id/btn_finalizar"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@drawable/button_primary"
                    app:backgroundTint="@null"
                    android:elevation="0dp"
                    android:text="@string/final_reg"
                    android:textAllCaps="false"
                    android:textColor="@color/marfil"
                    android:textSize="@dimen/text_size_button" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- CONTENEDOR PARA EL FRAGMENTO (Oculto por defecto) -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/marfil"
        android:visibility="gone" />

</FrameLayout>
