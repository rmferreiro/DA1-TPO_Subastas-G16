<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1EA"
    android:padding="16dp">

    <!-- BOTÓN SUPERIOR: NUEVO ARTÍCULO Y ADMINISTRAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nuevo_articulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ Nuevo artículo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:backgroundTint="#1C2A21"
            app:cornerRadius="8dp"
            app:elevation="0dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_administrar_articulos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Administrar artículos"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:backgroundTint="#C6A75E"
            app:cornerRadius="8dp"
            app:elevation="0dp"
            android:visibility="gone"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TEXTO ESTADO VACÍO -->
        <TextView
            android:id="@+id/txt_estado_vacio"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Todavía no tenés ningún articulo para subastar"
            android:textColor="#9E9E9E"
            android:textSize="15sp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- LISTA DE ARTÍCULOS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_mis_articulos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

        <!-- INDICADOR DE CARGA -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#C6A75E"
            android:visibility="visible" />
    </FrameLayout>

</LinearLayout>
