<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F4F1EA"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filtros"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- ESTADO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado"
        android:textColor="#1A1A1A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btn_todas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todas"
            android:textColor="#F4F1EA"
            android:textSize="13sp"
            android:background="@drawable/button_primary"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btn_proximas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximas"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/btn_en_sala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="En sala"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btn_finalizadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finalizadas"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

    </LinearLayout>

    <!-- CATEGORÍA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Categoría"
        android:textColor="#1A1A1A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btn_oro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oro"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btn_platino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Platino"
            android:textColor="#F4F1EA"
            android:textSize="13sp"
            android:background="@drawable/button_primary"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/btn_diamante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diamante"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

    </LinearLayout>

    <!-- REMATADOR -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rematador"
        android:textColor="#1A1A1A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Spinner
        android:id="@+id/spinner_rematador"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="20dp" />

    <!-- FECHA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fecha Subasta"
        android:textColor="#1A1A1A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/input_fecha"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:hint="AA-MM-DD·HH-MM"
        android:textColor="#1A1A1A"
        android:textColorHint="#AAAAAA"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="24dp" />

    <!-- BOTÓN APLICAR -->
    <Button
        android:id="@+id/btn_aplicar_filtros"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/button_primary"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:text="Aplicar filtros"
        android:textAllCaps="false"
        android:textColor="#F4F1EA"
        android:textSize="15sp" />

</LinearLayout>