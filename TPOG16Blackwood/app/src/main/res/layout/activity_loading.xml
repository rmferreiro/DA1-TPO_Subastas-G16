<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/marfil">

    <!-- HEADER CON ID PARA EVITAR CRASH -->
    <include
        android:id="@+id/include_header"
        layout="@layout/view_header" />

    <!-- CONTENIDO DE CARGA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="100dp"
            android:layout_marginBottom="24dp">

            <!-- Círculo negro con borde gris (Idéntico a procesamiento de registro) -->
            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_black" />

            <!-- Arco dorado rotatorio (ProgressBar) -->
            <ProgressBar
                android:id="@+id/loading_progress"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/loading_ring" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_procesando"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/charcoal"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_loading_desc"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:text="@string/espere"
            android:textColor="@color/gray_light"
            android:textSize="@dimen/text_size_small"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tv_loading_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/info_box"
            android:padding="14dp"
            android:text="@string/validando_op"
            android:textColor="@color/gray_light"
            android:textSize="@dimen/text_size_small" />

    </LinearLayout>

</LinearLayout>
