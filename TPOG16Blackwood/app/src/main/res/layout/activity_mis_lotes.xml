<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1EA">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1C2A21">

        <TextView
            android:text="Blackwood Fine Sales"
            android:textColor="#F4F1EA"
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Mis lotes"
            android:textColor="#C6A75E"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- FILTROS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#F4F1EA">

        <Button
            android:id="@+id/filtroTodos"
            android:text="Todos"
            android:background="@drawable/button_primary"
            android:textColor="#F4F1EA"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:textSize="12sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/filtroEnProceso"
            android:text="En proceso"
            android:background="@drawable/button_black_gold"
            android:textColor="#6B6B6B"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:textSize="11sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/filtroAprobados"
            android:text="Aprobados"
            android:background="@drawable/button_black_gold"
            android:textColor="#6B6B6B"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:textSize="11sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/filtroRechazados"
            android:text="Rechaz."
            android:background="@drawable/button_black_gold"
            android:textColor="#6B6B6B"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:textSize="11sp"
            android:stateListAnimator="@null"
            android:padding="8dp" />

        <Button
            android:id="@+id/filtroVendidos"
            android:text="Vendidos"
            android:background="@drawable/button_black_gold"
            android:textColor="#6B6B6B"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:textSize="11sp"
            android:stateListAnimator="@null"
            android:padding="8dp" />
    </LinearLayout>

    <!-- LISTA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLotes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false" />

</LinearLayout>