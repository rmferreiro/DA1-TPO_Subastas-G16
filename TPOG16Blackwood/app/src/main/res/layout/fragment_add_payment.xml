<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER REUTILIZABLE -->
        <include
            android:id="@+id/include_header"
            layout="@layout/view_header" />

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- TITULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/nuevo_metodo"
                android:textColor="#1A1A1A"
                android:textSize="@dimen/text_size_title" />

            <!-- SELECTOR TIPO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:hintEnabled="false"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                app:endIconTint="@color/green_dark">

                <AutoCompleteTextView
                    android:id="@+id/spinner_tipo_pago"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/input_bg"
                    android:hint="@string/tipo_pago_ph"
                    android:textColorHint="#7B7B7B"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/text_size_body"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- TITULAR -->
            <EditText
                android:id="@+id/et_titular"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="Titular"
                android:inputType="textPersonName"
                android:importantForAutofill="yes"
                android:autofillHints="name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="@dimen/text_size_body" />

            <!-- NUMERO -->
            <EditText
                android:id="@+id/et_numero"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="@string/cuenta_ph"
                android:inputType="number"
                android:importantForAutofill="yes"
                android:autofillHints="creditCardNumber"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="@dimen/text_size_body" />

            <!-- BANCO -->
            <EditText
                android:id="@+id/et_banco"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="Banco"
                android:inputType="text"
                android:importantForAutofill="no"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="@dimen/text_size_body" />

            <!-- VENCIMIENTO -->
            <EditText
                android:id="@+id/et_vencimiento"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="@string/tarjeta_ven"
                android:inputType="text"
                android:importantForAutofill="yes"
                android:autofillHints="creditCardExpirationDate"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="@dimen/text_size_body" />

            <!-- PAIS -->
            <EditText
                android:id="@+id/et_pais"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_bg"
                android:hint="@string/pais_org_ph"
                android:inputType="text"
                android:importantForAutofill="yes"
                android:autofillHints="countryName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="@dimen/text_size_body" />

            <!-- INFO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/info_box"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:text="@string/medio_pago_info"
                android:textColor="#6B6B6B"
                android:textSize="@dimen/text_size_small" />

            <!-- BOTON -->
            <Button
                android:id="@+id/btn_guardar_pago"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:background="@drawable/button_primary"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:text="@string/guardar_mp"
                android:textAllCaps="false"
                android:textColor="#F4F1EA"
                android:textSize="@dimen/text_size_button" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
