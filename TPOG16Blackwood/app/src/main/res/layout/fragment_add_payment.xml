<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F4F1EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#1C2A21"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blackwood Fine Sales"
                android:textColor="#F4F1EA"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar medio de pago"
                android:textColor="#C6A75E"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- TITULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="Nuevo método"
                android:textColor="#1A1A1A"
                android:textSize="18sp" />

            <!-- SELECTOR TIPO -->
            <Spinner
                android:id="@+id/spinner_tipo_pago"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- TITULAR -->
            <EditText
                android:id="@+id/et_titular"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="Titular"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="15sp" />

            <!-- NUMERO -->
            <EditText
                android:id="@+id/et_numero"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="Número de tarjeta / cuenta"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="15sp" />

            <!-- BANCO -->
            <EditText
                android:id="@+id/et_banco"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="Banco"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="15sp" />

            <!-- VENCIMIENTO -->
            <EditText
                android:id="@+id/et_vencimiento"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="Vencimiento (MM/AA)"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="15sp" />

            <!-- PAIS -->
            <EditText
                android:id="@+id/et_pais"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_bg"
                android:hint="País de origen"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#7B7B7B"
                android:textSize="15sp" />

            <!-- INFO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/info_box"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:text="Los medios de pago serán verificados por nuestro equipo antes de habilitar su uso en subastas."
                android:textColor="#6B6B6B"
                android:textSize="13sp" />

            <!-- BOTON -->
            <Button
                android:id="@+id/btn_guardar_pago"
                android:layout_width="match_parent"
                android:layout_height="58dp"

                android:background="@drawable/button_black_gold"
                android:backgroundTint="@null"
                app:backgroundTint="@null"

                android:elevation="0dp"

                android:text="Guardar medio de pago"
                android:textAllCaps="false"
                android:textColor="#F4F1EA"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>