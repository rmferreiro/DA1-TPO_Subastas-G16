<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/marfil"
    android:importantForAutofill="noExcludeDescendants">

    <!-- HEADER REUTILIZABLE -->
    <include
        android:id="@+id/include_header"
        layout="@layout/view_header" />

    <!-- CONTENIDO CENTRADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- CÍRCULO + ARCO DORADO ANIMADO -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp">

            <!-- Círculo negro con borde gris (Fondo estático) -->
            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_black" />

            <!-- Arco dorado rotatorio (ProgressBar) -->
            <ProgressBar
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/loading_ring" />
        </FrameLayout>

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ver_info"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/charcoal"
            android:layout_marginBottom="10dp"/>

        <!-- DESCRIPCIÓN -->
        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:text="@string/ver_info_description"
            android:textColor="@color/gray_light"
            android:textSize="@dimen/text_size_small"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- CAJA INFO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/info_box"
            android:padding="14dp"
            android:text="@string/ver_info_info"
            android:textColor="@color/gray_light"
            android:textSize="@dimen/text_size_small"
            android:layout_marginBottom="20dp"/>

        <!-- ESTADO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ver_info_estatus"
            android:textColor="@color/gold"
            android:textSize="@dimen/text_size_small"/>

    </LinearLayout>

</LinearLayout>
