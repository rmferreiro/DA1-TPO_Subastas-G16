<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C2A21"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C2A21"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_logo_diamond"
                android:contentDescription="Logo Blackwood" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blackwood Fine Sales"
                android:textColor="#F4F1EA"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle del lote"
                android:textColor="#C6A75E"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            

            <TextView
                android:id="@+id/tv_lote_numero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOTE #007"
                android:textColor="#C6A75E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/chip_outline_gold_border" />

            <!-- Galería de imágenes con swipe -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_imagenes"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <!-- Dots indicador -->
                <LinearLayout
                    android:id="@+id/ll_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp"
                    android:paddingTop="4dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#F4F1EA"
                android:padding="16dp">

                <!-- Card Info -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E0D8"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_titulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cargando..."
                            android:textColor="#1C2A21"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_subtitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textColor="#6B6B6B"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E0D8"
                            android:layout_marginVertical="12dp"/>

                        <!-- Grid de Datos -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Nº de pieza"
                                android:textColor="#6B6B6B"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tv_n_pieza"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="..."
                                android:textColor="#1C2A21"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E0D8" android:layout_marginVertical="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Precio base"
                                android:textColor="#6B6B6B"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tv_precio_base"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$ -"
                                android:textColor="#C6A75E"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E0D8" android:layout_marginVertical="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Puja mínima"
                                android:textColor="#6B6B6B"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tv_puja_minima"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$ -"
                                android:textColor="#1C2A21"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E0D8" android:layout_marginVertical="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Dueño actual"
                                android:textColor="#6B6B6B"
                                android:textSize="14sp" />
                            
                            <TextView
                                android:id="@+id/tv_duenio_avatar"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:text="GF"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:background="@drawable/circle_dark"
                                android:layout_marginEnd="8dp"/>
                            
                            <TextView
                                android:id="@+id/tv_duenio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="..."
                                android:textColor="#1C2A21"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Estado -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E0D8"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Estado del lote"
                            android:textColor="#6B6B6B"
                            android:textSize="14sp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E0D8" android:layout_marginVertical="12dp"/>

                        <TextView
                            android:id="@+id/tv_estado_titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disponible para pujar"
                            android:textColor="#1C2A21"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_tiempo_restante"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="La subasta cierra en --:--"
                            android:textColor="#6B6B6B"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Descripcion -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E0D8"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Descripción"
                            android:textColor="#6B6B6B"
                            android:textSize="14sp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E0D8" android:layout_marginVertical="12dp"/>

                        <TextView
                            android:id="@+id/tv_descripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textColor="#1C2A21"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Obra de Arte (visible solo para OBRA_ARTE) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_obra_arte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E0D8"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Información de la obra"
                            android:textColor="#6B6B6B"
                            android:textSize="14sp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#E5E0D8" android:layout_marginVertical="12dp"/>

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Artista"
                                android:textColor="#6B6B6B" android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tv_obra_artista"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="-" android:textColor="#1C2A21"
                                android:textStyle="bold" android:textSize="14sp" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#E5E0D8" android:layout_marginVertical="12dp"/>

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Fecha de creación"
                                android:textColor="#6B6B6B" android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tv_obra_fecha"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="-" android:textColor="#1C2A21"
                                android:textStyle="bold" android:textSize="14sp" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#E5E0D8" android:layout_marginVertical="12dp"/>

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Historia" android:textColor="#6B6B6B" android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tv_obra_historia"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="-" android:textColor="#1C2A21"
                            android:textSize="14sp" android:lineSpacingExtra="4dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</LinearLayout>
