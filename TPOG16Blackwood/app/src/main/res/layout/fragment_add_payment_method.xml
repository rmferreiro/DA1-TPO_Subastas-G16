<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1EA"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER CON PADDING SUPERIOR AJUSTADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1C2A21"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blackwood Fine Sales"
                android:textColor="#F4F1EA"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar medio de pago"
                android:textColor="#C6A75E"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <!-- SELECTOR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de pago"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:layout_marginBottom="14dp" />

            <Spinner
                android:id="@+id/spinner_tipo_pago"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:layout_marginBottom="20dp"/>

            <!-- CAMPOS DINÁMICOS -->
            <LinearLayout
                android:id="@+id/dynamic_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- BOTÓN -->
            <Button
                android:id="@+id/btn_guardar_pago"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Guardar medio de pago"
                android:textAllCaps="false"
                android:textColor="#F4F1EA"
                android:textSize="18sp"
                android:elevation="0dp"
                android:layout_marginTop="12dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>