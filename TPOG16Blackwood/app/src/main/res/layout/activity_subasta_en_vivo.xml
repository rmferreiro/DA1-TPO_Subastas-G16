<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#1C2A21"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp"
            android:text="←"
            android:textColor="#F4F1EA"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blackwood Fine Sales"
                android:textColor="#F4F1EA"
                android:textSize="15sp"
                android:textStyle="normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subasta en vivo"
                android:textColor="#C6A75E"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- STRIP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#2F3E34"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_gold"
            android:backgroundTint="#5C7A65" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="En sala · Activa"
            android:textColor="#F4F1EA"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORO"
            android:textColor="#C6A75E"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- CONTENIDO SCROLLEABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F4F1EA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD IMAGEN Y LOTE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_white"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp">
                    
                    <ImageView
                        android:id="@+id/iv_lote_imagen"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#E0DEDA"
                        android:src="@drawable/logo_blackwood" />


                    <!-- Badge LOTE #007 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:background="#1C2A21"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="LOTE #007"
                        android:textColor="#C6A75E"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_lote_numero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lote #007 de 24"
                        android:textColor="#C6A75E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_lote_titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Reloj Patek Philippe Calatrava 1950s"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="normal" />

                    <TextView
                        android:id="@+id/tv_lote_descripcion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Oro 18k · Cal. 27 SC · Certificado de autenticidad"
                        android:textColor="#6B6B6B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD PUJA MAS ALTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_white"
                android:backgroundTint="#1C2A21"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_titulo_puja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PUJA MÁS ALTA"
                    android:textColor="#A7A9AC"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_precio_actual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="$ 3.200 USD"
                    android:textColor="#C6A75E"
                    android:textSize="28sp"
                    android:textStyle="normal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Circulo avatar -->
                    <TextView
                        android:id="@+id/tv_avatar_iniciales"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_black"
                        android:backgroundTint="#1C2A21"
                        android:gravity="center"
                        android:text="MR"
                        android:textColor="#C6A75E"
                        android:textSize="12sp" />

                    <!-- Circular border over avatar workaround: we use standard circle_gold if needed but fine for now -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_nombre_postor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="M. Rodríguez"
                            android:textColor="#F4F1EA"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="hace 23 seg"
                            android:textColor="#6B6B6B"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_badge_lider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_outline_gold_border"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="Líder"
                        android:textColor="#C6A75E"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- CARD TIEMPO RESTANTE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiempo restante"
                    android:textColor="#6B6B6B"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_tiempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="04:37"
                        android:textColor="#1A1A1A"
                        android:textSize="24sp"
                        android:textStyle="normal" />

                    <!-- Progreso: usado aquí como progressPuja para compatibilidad, visualmente como timer progress -->
                    <ProgressBar
                        android:id="@+id/progress_puja"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="60"
                        android:progressTint="#C6A75E"
                        android:progressBackgroundTint="#E0DEDA" />

                </LinearLayout>

            </LinearLayout>

            <!-- CARD REALIZAR PUJA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Realizar una puja"
                    android:textColor="#6B6B6B"
                    android:textSize="11sp" />

                <!-- Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Menos -->
                    <LinearLayout
                        android:id="@+id/btn_decrementar"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="#F4F1EA"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="#1A1A1A"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <!-- Input -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="#F4F1EA"
                        android:gravity="center">
                        
                        <TextView
                            android:id="@+id/tv_oferta_input"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$ 3.210"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp" />
                            
                    </LinearLayout>

                    <!-- Más -->
                    <LinearLayout
                        android:id="@+id/btn_incrementar"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="#F4F1EA"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textColor="#1A1A1A"
                            android:textSize="20sp" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incremento mínimo: +$ 10 USD"
                    android:textColor="#6B6B6B"
                    android:textSize="10sp" />

                <!-- Boton Pujar -->
                <LinearLayout
                    android:id="@+id/btn_pujar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_primary"
                    android:backgroundTint="#C0A062"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_btn_pujar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ofertar $ 3.210 USD"
                        android:textColor="#1C2A21"
                        android:textSize="15sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- CARD PARTICIPANTES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Participantes en sala"
                        android:textColor="#6B6B6B"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_participantes_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#2F3E34"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="6 en línea"
                        android:textColor="#F4F1EA"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Avatars -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/circle_gold"
                        android:backgroundTint="#C0A062"
                        android:gravity="center"
                        android:text="TÚ"
                        android:textColor="#F4F1EA"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/circle_black"
                        android:backgroundTint="#2F3E34"
                        android:gravity="center"
                        android:text="MR"
                        android:textColor="#8B9B90"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/circle_black"
                        android:backgroundTint="#2F3E34"
                        android:gravity="center"
                        android:text="CL"
                        android:textColor="#8B9B90"
                        android:textSize="10sp" />
                        
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/circle_black"
                        android:backgroundTint="#2F3E34"
                        android:gravity="center"
                        android:text="AV"
                        android:textColor="#8B9B90"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/circle_black"
                        android:backgroundTint="#2F3E34"
                        android:gravity="center"
                        android:text="FD"
                        android:textColor="#8B9B90"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_black"
                        android:backgroundTint="#2F3E34"
                        android:gravity="center"
                        android:text="JM"
                        android:textColor="#8B9B90"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAV -->
    <include layout="@layout/bottom_nav" />

</LinearLayout>
