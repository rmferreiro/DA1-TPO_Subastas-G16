<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Separador superior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0DEDA" />

    <!-- Tabs row (increased h=64dp for better spacing) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">

        <!-- TAB 1: SUBASTAS -->
        <LinearLayout
            android:id="@+id/tab_subastas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Dot indicador activo -->
            <View
                android:id="@+id/tab_subastas_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/circle_gold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tab_subastas_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subastas"
                android:textColor="#1C2A21"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- TAB 2: MIS PUJAS -->
        <LinearLayout
            android:id="@+id/tab_mis_pujas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Dot indicador activo -->
            <View
                android:id="@+id/tab_pujas_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/circle_gold"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tab_pujas_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis pujas"
                android:textColor="#6B6B6B"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- TAB 3: MIS ARTÍCULOS -->
        <LinearLayout
            android:id="@+id/tab_mis_articulos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Dot indicador activo -->
            <View
                android:id="@+id/tab_articulos_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/circle_gold"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tab_articulos_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis artículos"
                android:textColor="#6B6B6B"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- TAB 4: PERFIL -->
        <LinearLayout
            android:id="@+id/tab_perfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Dot indicador activo -->
            <View
                android:id="@+id/tab_perfil_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/circle_gold"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tab_perfil_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#6B6B6B"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
