<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1EA"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C2A21"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_volver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#F4F1EA"
            android:textSize="20sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blackwood Fine Sales"
                android:textColor="#F4F1EA"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle del lote"
                android:textColor="#C6A75E"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENIDO CON SCROLL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/txt_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDIENTE DE INSPECCIÓN"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#C6A75E"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txt_nombre_lote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_duenio_lote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txt_valor_lote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#C6A75E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pieza en excelente estado de conservación. Incluye documentación original de procedencia y certificado de autenticidad. El dueño declara ser el propietario legal del bien sin impedimentos para su venta."
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fotografías (6)"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="#DDDDDD"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txt_motivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E53935"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- ===== BLOQUE 1: decisión inicial de inspección (PENDIENTE_INSPECCION) ===== -->
            <LinearLayout
                android:id="@+id/group_decision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_aceptar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/button_ok"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="Aceptar y enviar propuesta"
                    android:textAllCaps="false"
                    android:textColor="#F4F1EA"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_rechazar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/button_danger"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="Rechazar lote"
                    android:textAllCaps="false"
                    android:textColor="#F4F1EA"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- ===== BLOQUE 2: propuesta enviada, esperando respuesta del usuario ===== -->
            <LinearLayout
                android:id="@+id/group_propuesta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Condiciones propuestas"
                    android:textColor="#1A1A1A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txt_propuesta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Esperando respuesta del usuario…"
                    android:textColor="#2F6FAD"
                    android:textStyle="italic"
                    android:textSize="13sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_simular_aceptado"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/button_ok"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="Usuario aceptó las condiciones"
                    android:textAllCaps="false"
                    android:textColor="#F4F1EA"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_simular_rechazado"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/button_danger"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="Usuario rechazó las condiciones"
                    android:textAllCaps="false"
                    android:textColor="#F4F1EA"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- ===== BLOQUE 3: aceptado por el usuario -> asignar ubicación y póliza ===== -->
            <LinearLayout
                android:id="@+id/group_postventa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación y póliza de seguro"
                    android:textColor="#1A1A1A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/input_ubicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Depósito / ubicación del bien"
                    android:padding="10dp"
                    android:background="@android:drawable/edit_text"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/input_poliza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Número de póliza de seguro"
                    android:padding="10dp"
                    android:background="@android:drawable/edit_text"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_incluir_subasta"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/button_primary"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="Guardar e incluir en subasta"
                    android:textAllCaps="false"
                    android:textColor="#F4F1EA"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- ===== BLOQUE 4: estado final (incluido en subasta) - solo lectura ===== -->
            <LinearLayout
                android:id="@+id/group_final"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación y póliza"
                    android:textColor="#1A1A1A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txt_ubicacion_final"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txt_poliza_final"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#555555"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BARRA DE NAVEGACIÓN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nav_subastas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subastas"
                android:textColor="#888888"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_mis_pujas"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/circle_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis pujas"
                android:textColor="#C6A75E"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_perfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">


            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#888888"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
