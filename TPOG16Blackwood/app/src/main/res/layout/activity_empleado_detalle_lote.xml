<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1EA"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1C2A21"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_volver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#F4F1EA"
                android:textSize="20sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blackwood Fine Sales"
                    android:textColor="#F4F1EA"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalle del lote"
                    android:textColor="#C6A75E"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ESTADO -->
            <TextView
                android:id="@+id/txt_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN INSPECCIÓN"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#C6A75E"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txt_nombre_lote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_duenio_lote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txt_valor_lote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#C6A75E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pieza en excelente estado de conservación. Incluye documentación original de procedencia y certificado de autenticidad. El dueño declara ser el propietario legal del bien sin impedimentos para su venta."
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fotografías (6)"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="#DDDDDD"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txt_motivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E53935"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_aceptar"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Aceptar lote"
                android:textAllCaps="false"
                android:textColor="#F4F1EA"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_rechazar"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/button_danger"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Rechazar lote"
                android:textAllCaps="false"
                android:textColor="#F4F1EA"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>