<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">



    <!-- CHIPS ROW (h=60dp) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#F4F1EA"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Chip "Todas" seleccionado -->
            <TextView
                android:id="@+id/chip_todas"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/chip_dark"
                android:gravity="center"
                android:text="Todas"
                android:textColor="#F4F1EA"
                android:textSize="12sp" />

            <!-- Chip "Común" -->
            <TextView
                android:id="@+id/chip_comun"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/chip_outline_gold_border"
                android:gravity="center"
                android:text="Común"
                android:textColor="#6B6B6B"
                android:textSize="12sp" />

            <!-- Chip "Oro" -->
            <TextView
                android:id="@+id/chip_oro"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/chip_outline_gold_border"
                android:gravity="center"
                android:text="Oro"
                android:textColor="#6B6B6B"
                android:textSize="12sp" />

            <!-- Chip "Platino" -->
            <TextView
                android:id="@+id/chip_platino"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/chip_outline_gold_border"
                android:gravity="center"
                android:text="Platino"
                android:textColor="#6B6B6B"
                android:textSize="12sp" />

            <!-- Chip "Diamante" -->
            <TextView
                android:id="@+id/chip_diamante"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:background="@drawable/chip_outline_gold_border"
                android:gravity="center"
                android:text="Diamante"
                android:textColor="#6B6B6B"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- CONTENIDO SCROLLEABLE -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_subastas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F4F1EA"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false" />
</LinearLayout>
