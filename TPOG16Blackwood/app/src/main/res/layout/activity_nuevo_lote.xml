<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1EA">

    <!-- HEADER (solo "Nuevo Lote" en blanco) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingTop="24dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="#1C2A21">

        <TextView
            android:text="Nuevo Lote"
            android:textColor="#F4F1EA"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fotos del lote -->
            <LinearLayout
                android:id="@+id/layoutFotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/outline_gold"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutThumbnails"
                        android:layout_width="wrap_content"
                        android:layout_height="80dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvAddPhotoIcon"
                    android:text="+"
                    android:textSize="32sp"
                    android:textColor="#C6A75E"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvAddPhotoText"
                    android:text="Agregar fotos del lote"
                    android:textColor="#C6A75E"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Elementos incluidos -->
            <TextView
                android:text="Elementos incluidos"
                android:textSize="16sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/layoutElementos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAgregarElemento"
                android:text="+ Agregar elemento"
                android:background="@drawable/button_outline_verde"
                android:backgroundTint="@null"
                android:textColor="#1C2A21"
                android:padding="10dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null" />

            <!-- Descripción -->
            <TextView
                android:text="Descripción"
                android:textSize="16sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etDescripcionLote"
                android:hint="Historia, estado y detalles del lote"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:minLines="4"
                android:gravity="top"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Se requiere al menos 3 fotos del lote"
                android:textColor="#C0392B"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Botón enviar -->
            <Button
                android:id="@+id/btnEnviarEvaluacion"
                android:text="Enviar a evaluación"
                android:background="@drawable/button_primary"
                android:backgroundTint="@null"
                android:textColor="#F4F1EA"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <include layout="@layout/bottom_nav_vendedor" />

</LinearLayout>