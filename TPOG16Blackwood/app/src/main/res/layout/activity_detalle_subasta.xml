<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- HEADER igual al resto de la app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C2A21"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">


        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_logo_diamond"
                android:contentDescription="Logo Blackwood" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blackwood Fine Sales"
                android:textColor="#F4F1EA"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle de subasta"
                android:textColor="#C6A75E"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- STRIP de estado y categoría -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#2F3E34"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:id="@+id/dot_estado_detalle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_gold"
            android:backgroundTint="#A7A9AC" />

        <TextView
            android:id="@+id/tv_estado_strip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="..."
            android:textColor="#F4F1EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_categoria_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#C6A75E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CONTENIDO SCROLLEABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F4F1EA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- CARD INFO PRINCIPAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Fecha y hora -->
                <TextView
                    android:id="@+id/tv_fecha_hora_detalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#1A1A1A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E0DEDA" />

                <!-- Ubicación -->
                <TextView
                    android:id="@+id/tv_ubicacion_detalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación: —"
                    android:textColor="#6B6B6B"
                    android:textSize="12sp" />

                <!-- Rematador -->
                <TextView
                    android:id="@+id/tv_rematador_detalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rematador: —"
                    android:textColor="#6B6B6B"
                    android:textSize="12sp" />

                <!-- Moneda -->
                <TextView
                    android:id="@+id/tv_moneda_detalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Moneda: —"
                    android:textColor="#6B6B6B"
                    android:textSize="12sp" />

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E0DEDA" />

                <!-- Cantidad de lotes -->
                <TextView
                    android:id="@+id/tv_num_lotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— lotes"
                    android:textColor="#6B6B6B"
                    android:textSize="12sp" />

                <!-- Incremento mínimo -->
                <TextView
                    android:id="@+id/tv_incremento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Incremento mínimo: —"
                    android:textColor="#C6A75E"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- TÍTULO LOTES A SUBASTAR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Lotes a subastar"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Contenedor dinámico de lotes -->
            <LinearLayout
                android:id="@+id/layout_lotes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <!-- BOTÓN UNIRSE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ingresar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:text="Unirse a la puja"
                android:textColor="#1C2A21"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:backgroundTint="#C0A062"
                app:cornerRadius="8dp"
                app:elevation="0dp"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

        </LinearLayout>

    </ScrollView>


</LinearLayout>
