<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#1C2A21">

            <TextView
                android:text="Blackwood Fine Sales"
                android:textColor="#F4F1EA"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Nueva solicitud"
                android:textColor="#C6A75E"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:text="Datos del artículo"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Nombre artículo -->
            <TextView
                android:text="Nombre del artículo *"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/etNombreArticulo"
                android:hint="Ej: Juego de té de porcelana"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Categoría -->
            <TextView
                android:text="Categoría *"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/etCategoria"
                android:hint="Ej: Antigüedades, Arte, Joyería"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Descripción -->
            <TextView
                android:text="Descripción *"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/etDescripcion"
                android:hint="Describí el artículo en detalle"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:minLines="4"
                android:gravity="top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Estado del producto -->
            <TextView
                android:text="Estado del producto *"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/etEstadoProducto"
                android:hint="Ej: Excelente, Bueno, Regular"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Precio estimado -->
            <TextView
                android:text="Precio estimado *"
                android:textSize="13sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/etPrecioEstimado"
                android:hint="Ej: 5000"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:inputType="numberDecimal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- FOTOS -->
            <TextView
                android:text="Fotos del artículo"
                android:textSize="18sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnAgregarFotos"
                android:text="+ Agregar fotos (mín. 1)"
                android:background="@drawable/button_black_gold"
                android:textColor="#6B6B6B"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/tvFotosCount"
                android:text="0 fotos seleccionadas"
                android:textColor="#6B6B6B"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Declaración -->
            <CheckBox
                android:id="@+id/cbDeclaracionPropiedad"
                android:text="Declaro que el bien me pertenece y no poseo ningún impedimento legal para su venta"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Botón enviar -->
            <Button
                android:id="@+id/btnEnviarSolicitud"
                android:text="Enviar solicitud"
                android:background="@drawable/button_primary"
                android:textColor="#F4F1EA"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null" />

            <!-- Info -->
            <TextView
                android:text="Tu solicitud será evaluada por nuestro equipo. Te notificaremos el resultado y los pasos a seguir."
                android:background="@drawable/info_box"
                android:padding="14dp"
                android:textColor="#6B6B6B"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>