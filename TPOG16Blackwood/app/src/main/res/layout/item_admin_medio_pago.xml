<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E0D8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila superior: ícono + tipo + usuario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_admin_tipo_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_crop"
                android:background="@drawable/badge_background"
                android:backgroundTint="#FBF6EB"
                android:padding="8dp"
                android:layout_marginEnd="12dp"
                app:tint="#C6A75E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_admin_tipo_mp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tarjeta de Crédito"
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_admin_dueno_mp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Usuario: Nombre Apellido"
                    android:textColor="#6B6B6B"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#F0EBE3" />

        <!-- Identificador enmascarado (últimos 4 dígitos) -->
        <TextView
            android:id="@+id/tv_admin_detalle_mp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Termina en **** 1234"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:letterSpacing="0.05" />

        <!-- Botón verificar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_verificar_mp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Verificar medio de pago"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="#C6A75E"
            app:cornerRadius="8dp"
            app:elevation="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
