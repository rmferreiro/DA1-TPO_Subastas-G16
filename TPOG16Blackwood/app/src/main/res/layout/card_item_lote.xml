<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/input_bg"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreLote"
                android:textSize="16sp"
                android:textColor="#1A1A1A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvCategoriaLote"
                android:textSize="12sp"
                android:textColor="#6B6B6B"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvFechaLote"
                android:textSize="11sp"
                android:textColor="#6B6B6B"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Estado badge -->
        <TextView
            android:id="@+id/tvEstadoLote"
            android:textSize="11sp"
            android:padding="6dp 10dp"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/btnVerDetalle"
        android:text="Ver detalle"
        android:background="@drawable/button_black_gold"
        android:textColor="#1A1A1A"
        android:padding="8dp"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:textSize="12sp"
        android:stateListAnimator="@null" />

</LinearLayout>