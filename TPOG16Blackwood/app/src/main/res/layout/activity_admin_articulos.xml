<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1EA"
    android:importantForAutofill="noExcludeDescendants">

    <!-- HEADER REUTILIZABLE -->
    <include
        android:id="@+id/include_header"
        layout="@layout/view_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- TEXTO ESTADO VACÍO -->
        <TextView
            android:id="@+id/txt_estado_vacio"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No hay artículos pendientes de revisión"
            android:textColor="#9E9E9E"
            android:textSize="15sp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- LISTA DE ARTÍCULOS PENDIENTES -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_articulos_pendientes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />

        <!-- INDICADOR DE CARGA -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#C6A75E"
            android:visibility="visible" />
    </FrameLayout>

</LinearLayout>
