.mvn/wrapper/maven-wrapper.jar
**/mvnw.cmd
**/mvnw
# Logs
*.log
logs/
**/logs/

# =========================================================================
# ANDROID (Gradle)
# =========================================================================
# Gradle build directories
.gradle/
**/build/
build/
# Local configuration files (contains local SDK paths)
local.properties
**/local.properties
# Android Studio captures
captures/
**/captures/
# C++ build directories
.externalNativeBuild/
.cxx/
**/.externalNativeBuild/
**/.cxx/
# Package Files (APKs, AABs)
*.apk
*.ap_
*.aab
# Generated digital signatures
*.keystore
*.jks
!debug.keystore

